---
# Every public page, for search engines (submitted in Google Search Console). Drafts aren't in
# collections.posts, so they never appear here.
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc></url>
  <url><loc>{{ site.url }}/blog/</loc>{% if collections.posts | length %}<lastmod>{{ collections.posts[0].date | isoDate }}</lastmod>{% endif %}</url>
{% for post in collections.posts %}
  <url><loc>{{ site.url }}{{ post.url }}</loc><lastmod>{{ post.date | isoDate }}</lastmod></url>
{% endfor %}
</urlset>
