{# Nav pill + phone menu, shared by every page.
    root:   "" on the homepage (links stay "#about", so js/anchors.js scrolls smoothly), "/" on blog pages.
    docked: blog pages have no hero, so the nav starts with its buttons showing (and <html class="nav-docked">).
    The Writing link only exists once a post is published. -#}
{% set hasPosts = collections.posts | length %}
{% set writingHref = "/blog/" if docked else "#writing" %}
{% set hidden = "" if docked else " is-out" %}
{% set inert = "" if docked else " inert" %}
        <header class="site-header">
            <nav class="nav-pill">
                <div class="nav-glass" aria-hidden="true"></div>
                <a href="{{ root }}#top" class="nav-home" aria-label="Amier Lorenz Davis">
                    <img src="{{ root }}assets/avatar.webp" alt="Amier Lorenz Davis" class="avatar">
                </a>
                <div class="nav-links">
                    <a href="{{ root }}#about" class="nav-link">About</a>
                    <a href="{{ root }}#timeline" class="nav-link">Timeline</a>
                    <a href="{{ root }}#projects" class="nav-link">Projects</a>
{% if hasPosts %}
                    <a href="{{ writingHref }}" class="nav-link"{% if current == "blog" %} aria-current="page"{% endif %}>Writing</a>
{% endif %}
                    <a href="{{ root }}#skills" class="nav-link">Skills</a>
                    <a href="{{ root }}#contact" class="nav-link">Get In Touch</a>
                </div>
                <!-- Twins of the hero links: hidden (is-out, inert) until the nav reaches the hero row,
                     then they pop in (js/dock.js). Resume is a pill on desktop and a circle on phones. -->
                <div class="nav-actions">
                    <div class="nav-socials">
                        <a class="social-btn social-btn--youtube dock-pop{{ hidden }}" data-dock="youtube" href="https://www.youtube.com/@amierlorenz" target="_blank" rel="noopener" aria-label="YouTube"{{ inert }}><svg width="22" height="22" aria-hidden="true"><use href="#yt-mark"/></svg></a>
                        <a class="social-btn dock-pop{{ hidden }}" data-dock="medium" href="{{ site.medium }}" target="_blank" rel="noopener" aria-label="Medium"{{ inert }}><svg width="18" height="18" aria-hidden="true"><use href="#medium-mark"/></svg></a>
                        <a class="social-btn dock-pop{{ hidden }}" data-dock="github" href="https://github.com/amierlorenz" target="_blank" rel="noopener" aria-label="GitHub"{{ inert }}><svg width="20" height="20" aria-hidden="true"><use href="#gh-mark"/></svg></a>
                        <a class="social-btn nav-resume-circle dock-pop{{ hidden }}" data-dock="resume" href="{{ root }}resume.pdf" download aria-label="Download resume"{{ inert }}><svg width="18" height="18" aria-hidden="true"><use href="#download-icon"/></svg></a>
                    </div>
                    <a class="nav-resume dock-pop{{ hidden }}" data-dock="resume" href="{{ root }}resume.pdf" download{{ inert }}>Resume <svg width="18" height="18" aria-hidden="true"><use href="#download-icon"/></svg></a>
                </div>
                <button id="menu-button" class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
                    <span></span><span></span>
                </button>
            </nav>
        </header>

        <!-- Phone menu (≤760px): full-screen overlay opened by #menu-button; behavior in js/mobile-menu.js.
             Resume lives in the nav now, so the bottom row is the two ways to reach me. -->
        <nav id="mobile-menu" class="mobile-menu" aria-label="Menu">
            <ul class="mobile-menu-list">
{% set menu = [
    ["About", root + "#about"], ["Timeline", root + "#timeline"], ["Projects", root + "#projects"],
    ["Writing", writingHref] if hasPosts else null,
    ["Skills", root + "#skills"], ["Contact", root + "#contact"]
] | select %}
{% for item in menu %}
                <li><a href="{{ item[1] }}" style="--i:{{ loop.index0 }}">{{ item[0] }}</a></li>
{% endfor %}
            </ul>
            <div class="mobile-menu-reach">
                <a href="mailto:amierLdavis@gmail.com" class="mobile-menu-btn mobile-menu-btn--email"><svg width="20" height="20" aria-hidden="true"><use href="#mail-icon"/></svg><span>Email me</span></a>
                <a href="https://calendar.app.google/cnMKfDF11F9o77mK7" class="mobile-menu-btn" target="_blank" rel="noopener"><svg width="20" height="20" aria-hidden="true"><use href="#calendar-mark"/></svg><span>Book a Chat</span></a>
            </div>
        </nav>
