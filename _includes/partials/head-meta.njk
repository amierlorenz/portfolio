    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ pageTitle }}</title>
    <!-- Favicons: headshot on the site's yellow disc (made from assets/avatar.webp) -->
    <link rel="icon" type="image/png" sizes="64x64" href="{{ root }}assets/favicon.png">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ root }}assets/favicon-192.png">
    <link rel="apple-touch-icon" href="{{ root }}assets/apple-touch-icon.png">
    <meta name="description" content="{{ pageDescription }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Fonts: Instrument Serif (display), Rubik (body), Fira Code (mono); Rubik + Fira Code match the digital garden -->
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Rubik:wght@400;500;600&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
